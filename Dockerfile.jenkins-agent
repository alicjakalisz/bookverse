# Dockerfile.jenkins-agent

# Start from a trusted, official base image with Maven and a specific JDK.
FROM maven:3.9-eclipse-temurin-17

# The base image user is 'root', which is needed for installing packages.

# Install the Docker CLI client.
# This does NOT install the full Docker engine, just the command-line tool
# needed to communicate with the Docker socket you've mounted.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl gnupg lsb-release && \
    # Create the keyring directory with proper permissions
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    # Set up the repository using the correct path for Ubuntu
    echo \
      "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu \
      $(lsb_release -cs) stable" | tee /etc/apt/sources.list.d/docker.list > /dev/null && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce-cli && \
    # Clean up apt-get lists to keep the image size down
    rm -rf /var/lib/apt/lists/*

# The base 'maven' image's default user is 'root', which simplifies permissions
# for accessing the Docker socket. You can leave it as is.